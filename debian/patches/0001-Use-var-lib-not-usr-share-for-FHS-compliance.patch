From: Faidon Liambotis <paravoid@debian.org>
Date: Thu, 28 Dec 2023 00:01:44 +0200
Subject: Use /var/lib, not /usr/share for FHS compliance

sed -i 's;usr/share/secureboot;var/lib/secureboot;g'
---
 docs/sbctl.8.txt                       | 28 ++++++++++++++--------------
 keys.go                                |  2 +-
 tests/integrations/enroll_keys_test.go |  2 +-
 3 files changed, 16 insertions(+), 16 deletions(-)

diff --git a/docs/sbctl.8.txt b/docs/sbctl.8.txt
index 238f869..e7e4146 100644
--- a/docs/sbctl.8.txt
+++ b/docs/sbctl.8.txt
@@ -281,7 +281,7 @@ EFI signing commands
                 Migrate the configuration and setup of sbctl to a new iteration.
                 +
                 Currently the only migration for sbctl is moving from
-                /usr/share/secureboot to /var/lib/sbctl.
+                /var/lib/secureboot to /var/lib/sbctl.
 
         *--print-config*;;
                 Prints a serialized version of the current configuration of
diff --git a/sbctl.go b/sbctl.go
index 9962b1a..0e13c02 100644
--- a/sbctl.go
+++ b/sbctl.go
@@ -19,7 +19,7 @@ import (
 var (
 	// TODO: Remove this at some point
 	//       Only here for legacy reasons to denote the old path
-	DatabasePath = "/usr/share/secureboot/"
+	DatabasePath = "/var/lib/secureboot/"
 	Version      = "unknown"
 )
 
diff --git a/tests/integrations/enroll_keys/enroll_keys_test.go b/tests/integrations/enroll_keys/enroll_keys_test.go
index c72c795..0ee25c0 100644
--- a/tests/integrations/enroll_keys/enroll_keys_test.go
+++ b/tests/integrations/enroll_keys/enroll_keys_test.go
@@ -20,7 +20,7 @@ func TestEnrollKeys(t *testing.T) {
 	g.Expect(efi.GetSecureBoot()).To(BeFalse(), "should not be in secure boot mode")
 	g.Expect(efi.GetSetupMode()).To(BeTrue(), "should be in setup mode")
 
-	utils.Exec("rm -rf /usr/share/secureboot")
+	utils.Exec("rm -rf /var/lib/secureboot")
 	utils.Exec("sbctl status")
 	utils.Exec("sbctl create-keys")
 	out, err := utils.ExecWithOutput("sbctl enroll-keys")
